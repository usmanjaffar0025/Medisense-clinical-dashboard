# Copy to .env.local (git-ignored), fill in ONE key, then restart `pnpm dev`.
# The server log prints "[medisense-ai] <Provider> key ... is VALID" when the key works.
# Without any key the demo still runs on prepared drafts.

# Claude (Anthropic) - default model claude-opus-5-5
ANTHROPIC_API_KEY=

# OpenAI - default model gpt-5
OPENAI_API_KEY=

# Google AI Studio (Gemini) - default model gemini-2.5-pro
GEMINI_API_KEY=

# Groq - default model openai/gpt-oss-120b
GROQ_API_KEY=

# Optional: pick the provider when several keys are set (anthropic | openai | google | groq)
AI_PROVIDER=
# Optional: override the provider's default model, e.g. gpt-5-mini or gemini-2.5-flash
AI_MODEL=

# Optional: pin the platform to a day (YYYY-MM-DD). Empty = today in Brisbane.
# 2026-10-20 shows the records exactly as written.
NEXT_PUBLIC_DEMO_DATE=
